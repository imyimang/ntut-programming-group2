a = int(input())  # 網內語音(秒)
b = int(input())  # 網外語音(秒)
c = int(input())  # 市話(秒)
i = int(input())  # 網內簡訊(則)
j = int(input())  # 網外簡訊(則)

# 1. 計算各資費的原始通信費
cost_199 = 0.09 * a + 0.15 * b + 0.14 * c + 1.2 * i + 1.6 * j
cost_399 = 0.075 * a + 0.135 * b + 0.125 * c + 1.15 * i + 1.3 * j
cost_799 = 0.065 * a + 0.11 * b + 0.10 * c + 0.95 * i + 1.1 * j

# 2. 計算實際應繳金額（低於月租收月租，高於收通信費）
pay_199 = max(199.0, cost_199)
pay_399 = max(399.0, cost_399)
pay_799 = max(799.0, cost_799)

# 3. 打包資費方案並找出最低花費
plans = [
    (pay_199, "199型"),
    (pay_399, "399型"),
    (pay_799, "799型")
]

# min 會自動比較第一個元素（即金額 lowest）
best_cost, best_name = min(plans, key=lambda x: x[0])

# 4. 依題目要求輸出（若題目只要金額或類型，自行調整 print 內容）
print(int(best_cost))
print(best_name)